AZURE_AI_PROJECT_ENDPOINT=https://foundry-sre-project-resource.services.ai.azure.com/api/projects/foundry-sre-project
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
TRAVEL_AGENT_LOG_LEVEL=INFO
TRAVEL_TOOL_TIMEOUT_SECONDS=8
AZURE_TRACING_GEN_AI_CONTENT_RECORDING_ENABLED=true
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=SPAN_AND_EVENT
# Optional: dual-export traces to LangSmith alongside Foundry. Set
# LANGSMITH_TRACING=true and supply LANGSMITH_API_KEY to enable. Leaving it
# disabled keeps Foundry-only tracing.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Project1
CHAOS_MODE=off
CHAOS_RATE=0.1
CHAOS_LATENCY_MIN_SECONDS=5
CHAOS_LATENCY_MAX_SECONDS=20
